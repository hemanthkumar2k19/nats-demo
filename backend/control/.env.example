# Demo Control Service Port (UI Gateway on :8080)
PORT=8080

# Job Service Port (Pure Business API on :8081)
JOB_SERVICE_PORT=8081

# Processor Service Port (Direct Worker API on :8082)
PROCESSOR_PORT=8082

# Job Service internal URL used by Demo Control for health checks
JOB_SERVICE_URL=http://localhost:8081

# NATS Broker Connection URL & Authentication
NATS_URL=nats://localhost:4222
NATS_USER=app_user
NATS_PASSWORD=app_user_pwd!
NATS_SYS_USER=sys_admin
NATS_SYS_PASSWORD=sys_admin_pwd!


# Enable forwarding NATS $SYS and $JS.EVENT.ADVISORY.> operational events to Loki
ENABLE_NATS_EVENTS=false
