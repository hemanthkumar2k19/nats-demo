# ==============================================================================
# NATS Platform Reference Evaluation - Local Environment Configuration Template
# Copy this file to .env: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# NATS Cluster Connection
# ------------------------------------------------------------------------------
# Comma-separated list of NATS server endpoints in the local 3-node cluster.
# For single-node: nats://localhost:4222
# For 3-node cluster: nats://localhost:4222,nats://localhost:4223,nats://localhost:4224
NATS_SERVERS=nats://localhost:4222,nats://localhost:4223,nats://localhost:4224
NATS_URL=nats://localhost:4222
NATS_CLIENT_NAME=order-service

# ------------------------------------------------------------------------------
# Resilience, Timeouts & Reconnection
# ------------------------------------------------------------------------------
NATS_CONNECT_TIMEOUT=2s
NATS_ALLOW_RECONNECT=true
NATS_MAX_RECONNECT_ATTEMPTS=10
NATS_RECONNECT_WAIT=2s
NATS_RETRY_ON_FAILED_CONNECT=true
NATS_PING_INTERVAL=5s
NATS_MAX_PINGS_OUT=3
NATS_DRAIN_TIMEOUT=30s

# ------------------------------------------------------------------------------
# Security & Authentication (Disabled for local deployment)
# ------------------------------------------------------------------------------
NATS_TLS_ENABLED=false
# NATS_TLS_ROOT_CA_SOURCE=
# NATS_TLS_CLIENT_CERT_SOURCE=
# NATS_TLS_CLIENT_KEY_SOURCE=

# Authentication: none | token | user_password | jwt | credentials
# NATS_AUTH_METHOD=
# NATS_AUTH_TOKEN=
# NATS_AUTH_USER=
# NATS_AUTH_PASSWORD=
# NATS_AUTH_CREDENTIALS_FILE=

# ------------------------------------------------------------------------------
# HTTP Service Ports
# ------------------------------------------------------------------------------
ORDER_SERVICE_PORT=:8080
PROCESSING_SERVICE_PORT=:8081

# ------------------------------------------------------------------------------
# Observability & OpenTelemetry
# ------------------------------------------------------------------------------
SERVICE_NAME=nats-tracing-demo
OTEL_EXPORTER_TYPE=otlp-grpc
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317

