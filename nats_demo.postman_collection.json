              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "publish"
              ]
            },
            "description": "Publishes a message to Core NATS with at-most-once delivery semantics (fire-and-forget, non-persistent subject)."
