            "body": {
              "mode": "raw",
              "raw": "{\n  \"subject\": \"delivery.atmost-once\",\n  \"data\": {\n    \"status\": \"dispatched\",\n    \"trackingUrl\": \"https://carrier.local/track\"\n  },\n  \"headers\": {\n    \"Source\": \"order-service\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
