              "raw": "{\n  \"subject\": \"delivery.atleast-once\",\n  \"data\": {\n    \"amount\": 250.00,\n    \"currency\": \"USD\",\n    \"customer\": \"acme-corp\"\n  },\n  \"headers\": {\n    \"Source\": \"order-service\"\n  }\n}",
