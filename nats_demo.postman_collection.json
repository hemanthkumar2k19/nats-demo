        {
          "name": "JetStream Batch Publish (Async)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"subject\": \"payments.created\",\n  \"count\": 6\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/publish/js/batch",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "publish",
                "js",
                "batch"
              ]
            },
            "description": "Publishes a batch of messages to JetStream asynchronously for testing worker concurrency and competing consumers. Accepts {\"subject\": \"...\", \"count\": N} or an array of message objects. Each message is stamped with a consistent order ID (e.g. Order ORD-<rand>-<index>) so they can be easily tracked across competing workers."
          },
          "response": [
            {
              "name": "200 OK - Batch Published",
              "originalRequest": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
