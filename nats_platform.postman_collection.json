                  "key": "Content-Type",
                  "value": "application/json; charset=utf-8"
                }
              ],
              "body": "{\n  \"stream_name\": \"PAYMENTS\",\n  \"name\": \"payments-pull\",\n  \"created\": \"2026-10-15T10:45:00Z\",\n  \"config\": {\n    \"durable_name\": \"payments-pull\",\n    \"filter_subjects\": [\n      \"payments.>\"\n    ],\n    \"ack_policy\": \"explicit\",\n    \"deliver_policy\": \"all\"\n  }\n}"
